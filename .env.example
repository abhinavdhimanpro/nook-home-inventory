# Added automatically by the Neon integration in Vercel Marketplace.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Required household login. Keep these values in Vercel environment variables.
NOOK_USERNAME=choose-a-private-username
NOOK_PASSWORD=choose-a-long-private-password

# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret
